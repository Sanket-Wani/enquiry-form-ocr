# Database Connection (Default SQLite for standalone local operation)
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vishal_chugera_ocr?schema=public"
DATABASE_URL="file:./dev.db"

# Sarvam DocAI API Credentials (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_subscription_key_here
# Optional: Sarvam saved config ID if using pre-configured DocAI schema
SARVAM_CONFIG_ID=

# CRM Integration Settings
# Options: 'mock' (simulated real-estate CRM with audit trail), 'webhook' (HTTP POST payload), 'rest' (Standard JSON REST endpoint)
CRM_TYPE=mock
CRM_ENDPOINT_URL=https://crm.vishalchugera.com/api/v1/leads
CRM_API_KEY=crm_secret_token_here

# Field Confidence Warning Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75
